# ── Aeltra Outbound · variables de entorno ──
# Copiá este archivo como .env y completá los valores.

# Claude / Anthropic (para los agentes de copy, búsqueda y orquestador)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (pocas llamadas caras; el envío de cada mail NO usa IA)
LLM_MODEL=claude-opus-5

# ── Backend de envío: 'smtp' (app password) o 'gmail_oauth' (Gmail API OAuth2) ──
SENDER_BACKEND=gmail_oauth

# ── Gmail OAuth2 (corré gmail_oauth_setup.py para obtenerlos) ──
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=contacto.aeltra@gmail.com

# ── Envío por Gmail SMTP (App Password) — solo si SENDER_BACKEND=smtp ──
# 1) Activá verificación en 2 pasos en la cuenta.
# 2) Generá un App Password (https://myaccount.google.com/apppasswords) y pegalo abajo SIN espacios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aeltra.contacto@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
FROM_NAME=Aeltra
FROM_EMAIL=aeltra.contacto@gmail.com

# ── Fuente de prospectos ──
# MOCK=true genera prospectos falsos para probar el sistema sin gastar nada.
PROSPECTS_MOCK=true
APIFY_TOKEN=

# ── Auth (protege la app deployada; dejá vacío en local) ──
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ── Identidad / baja (compliance) ──
COMPANY_NAME=Aeltra
COMPANY_TAGLINE=Software & IA
UNSUB_BASE=http://localhost:8000/api/baja

# ── Ritmo de envío por defecto (se puede pisar por campaña) ──
DEFAULT_WINDOW_HOURS=6
DAILY_SEND_CAP=40
